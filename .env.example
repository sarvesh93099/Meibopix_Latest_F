# Local development. Generate your own SECRET_KEY before starting the backend.
APP_ENV=development
HOST=127.0.0.1
PORT=5000
DEBUG=false
SECRET_KEY=replace-with-a-strong-secret

# Frontend / sessions. Production requires HTTPS and secure cookies.
FRONTEND_DIST_DIR=./frontend/dist
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3002,http://127.0.0.1:3002
VITE_API_URL=
ENFORCE_HTTPS=false
SESSION_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# CPU PyTorch is the default for Docker and deployment installs.
TORCH_DEVICE=cpu
MODEL_PATH=./backend/meibography_models
# Optional deploy-time source: a local folder or private S3 prefix. Never fetched during requests.
MODEL_SOURCE=

# SQLite and local storage need no external services.
DATABASE_URL=
STORAGE_BACKEND=local
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Limits and modest thread pools for small servers.
MAX_CONTENT_LENGTH_MB=220
MAX_IMAGE_UPLOAD_MB=15
MAX_IMAGE_PIXELS=12000000
IMAGE_PROCESSING_MAX_DIMENSION=1600
MAX_REPORT_UPLOAD_MB=20
MAX_VIDEO_UPLOAD_MB=200
OPENCV_THREADS=1
# 0 selects up to 6 CPU threads within the available CPU allocation.
TORCH_THREADS=0
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
WAITRESS_THREADS=4
WAITRESS_CONNECTION_LIMIT=50
WAITRESS_CHANNEL_TIMEOUT=120
WAITRESS_CLEANUP_INTERVAL=30
APP_LOG_LEVEL=INFO
APP_LOG_FILE=
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=3
APP_LOG_ACCESS_LOGS=true
ENABLE_CAMERA=false

# Optional doctor / admin seed. Leave blank or supply your own credentials.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=
AUTH_ENABLE_2FA=false
AUTH_2FA_SECRET=

# Optional S3 storage: use STORAGE_BACKEND=s3 and an IAM role in production.
S3_BUCKET=
AWS_REGION=ap-south-1
S3_UPLOAD_PREFIX=uploads
S3_REPORT_PREFIX=reports
