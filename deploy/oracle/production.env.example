APP_ENV=production
HOST=127.0.0.1
PORT=5000
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
ENFORCE_HTTPS=true
SESSION_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
CORS_ORIGINS=https://REPLACE-ME.vercel.app
ENABLE_CAMERA=false

MODEL_PATH=/opt/meibography/meibography/backend/meibography_models
STORAGE_BACKEND=local
DATABASE_URL=sqlite:////opt/meibography/meibography/backend/meibography.db
UPLOAD_FOLDER=/opt/meibography/meibography/backend/uploads
REPORT_FOLDER=/opt/meibography/meibography/backend/reports
OPENCV_THREADS=1
TORCH_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
WAITRESS_THREADS=4
WAITRESS_CONNECTION_LIMIT=50
APP_LOG_ACCESS_LOGS=true

# Replace both passwords before setup. Admin approves staff; doctor uses the clinical UI.
AUTH_ADMIN_USERNAME=site-admin
AUTH_ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_BOOTSTRAP_USERNAME=site-doctor
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
AUTH_ENABLE_2FA=false
