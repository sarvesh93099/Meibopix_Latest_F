{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE-ME.duckdns.org/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://REPLACE-ME.duckdns.org/uploads/:path*" },
    { "source": "/reports/:path*", "destination": "https://REPLACE-ME.duckdns.org/reports/:path*" },
    { "source": "/((?!api/|uploads/|reports/|assets/).*)", "destination": "/index.html" }
  ]
}
