# Production environment template for AWS deployment

# Core app
HOST=0.0.0.0
PORT=5000
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret

# Reverse proxy / frontend
FRONTEND_DIST_DIR=/opt/meibography/meibography/frontend/dist
CORS_ORIGINS=https://app.your-domain.example
VITE_API_URL=https://api.your-domain.example
ENFORCE_HTTPS=true
SESSION_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=None

# Models
MODEL_PATH=/opt/meibography/meibography/backend/meibography_models

# Database
DATABASE_URL=postgresql+psycopg2://user:password@your-rds-endpoint:5432/meibography
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Storage
STORAGE_BACKEND=s3
S3_BUCKET=your-storage-bucket
AWS_REGION=ap-south-1
S3_UPLOAD_PREFIX=uploads
S3_REPORT_PREFIX=reports

# Runtime
MAX_CONTENT_LENGTH_MB=512
WAITRESS_THREADS=8
WAITRESS_CONNECTION_LIMIT=100
WAITRESS_CHANNEL_TIMEOUT=120
WAITRESS_CLEANUP_INTERVAL=30
APP_LOG_LEVEL=INFO
APP_LOG_FILE=
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
APP_LOG_ACCESS_LOGS=true
ENABLE_CAMERA=false

# Single-user auth
AUTH_BOOTSTRAP_USERNAME=your-admin-user
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# Optional 2FA
AUTH_ENABLE_2FA=false
AUTH_2FA_SECRET=
