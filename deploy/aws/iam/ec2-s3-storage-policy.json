{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListStorageBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::YOUR_STORAGE_BUCKET_NAME"
    },
    {
      "Sid": "ReadWriteStorageObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_STORAGE_BUCKET_NAME/*"
    }
  ]
}
