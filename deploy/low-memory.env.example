# Merge these settings into .env; keep your existing secrets and storage paths.
# Install backend/requirements.txt; these settings limit runtime memory use.
MEIBOGRAPHY_INFERENCE_BACKEND=onnx
MODEL_PATH=backend/meibography_models/onnx
MEIBOGRAPHY_MODEL_FOLDER=backend/meibography_models/onnx
ENABLE_CAMERA=false
ENABLE_SERVER_BLINK=false
DEBUG=false
ONNX_THREADS=1
ONNX_RELEASE_AFTER_REQUEST=true
OPENCV_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MALLOC_ARENA_MAX=2
WAITRESS_THREADS=2
WAITRESS_CONNECTION_LIMIT=16
WAITRESS_INBUF_OVERFLOW=65536
WAITRESS_OUTBUF_OVERFLOW=262144
WAITRESS_OUTBUF_HIGH_WATERMARK=1048576
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0
MAX_CONTENT_LENGTH_MB=12
MAX_IMAGE_UPLOAD_MB=5
# Includes the original 1360x1024 sample images without resizing measurements.
MAX_IMAGE_PIXELS=1500000
MAX_REPORT_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=5
IMAGE_PROCESSING_MAX_DIMENSION=1024
MAX_GLAND_PROGRESS_FRAMES=0
